-- Terreno (voxels)
--------------------------------------------------------------------------------

local function rleEncode(flat)
    local out, last, cnt = {}, nil, 0
    for i = 1, #flat do
        local v = flat[i]
        if v == last then
            cnt = cnt + 1
        else
            if last ~= nil then out[#out + 1] = last; out[#out + 1] = cnt end
            last, cnt = v, 1
        end
    end
    if last ~= nil then out[#out + 1] = last; out[#out + 1] = cnt end
    return out
end

local function rleDecode(arr)
    local out, n = {}, 0
    for i = 1, #arr, 2 do
        for _ = 1, arr[i + 1] do
            n = n + 1
            out[n] = arr[i]
        end
    end
    return out
end

local function copyTerrain(mapFolder, setStatus)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return 0, 0 end

    local okE, ext = pcall(function() return terrain.MaxExtents end)
    if not okE or not ext then return 0, 0 end

    local mn, mx = ext.Min, ext.Max
    local C = TERRAIN_CHUNK
    local nx = math.ceil((mx.X - mn.X + 1) / C)
    local ny = math.ceil((mx.Y - mn.Y + 1) / C)
    local nz = math.ceil((mx.Z - mn.Z + 1) / C)
    local totalChunks = nx * ny * nz
    if totalChunks <= 0 then return 0, 0 end
    if totalChunks > 30000 then
        setStatus("Terreno grande demais, foi ignorado.")
        task.wait(2)
        return 0, 0
    end

    local air = Enum.Material.Air
    local buf, files, saved, done = {}, 0, 0, 0

    local function flush()
        if #buf == 0 then return end
        files = files + 1
        local okJ, enc = pcall(HttpService.JSONEncode, HttpService, {Chunks = buf})
        if okJ then writeVerified(string.format("%s/Terrain_%03d.json", mapFolder, files), enc) end
        buf = {}
    end

    for ix = 0, nx - 1 do
        for iy = 0, ny - 1 do
            for iz = 0, nz - 1 do
                if cancelRequested then return nil end

                local vx, vy, vz = mn.X + ix * C, mn.Y + iy * C, mn.Z + iz * C
                local sx = math.min(C, mx.X - vx + 1)
                local sy = math.min(C, mx.Y - vy + 1)
                local sz = math.min(C, mx.Z - vz + 1)
                local region = Region3.new(
                    Vector3.new(vx * 4, vy * 4, vz * 4),
                    Vector3.new((vx + sx) * 4, (vy + sy) * 4, (vz + sz) * 4))

                local okR, mats, occ = pcall(terrain.ReadVoxels, terrain, region, 4)
                if okR and mats and occ then
                    local size = mats.Size
                    local ax, ay, az = size.X, size.Y, size.Z
                    local mflat, oflat, n, solid = {}, {}, 0, false
                    for i = 1, ax do
                        for j = 1, ay do
                            for k = 1, az do
                                n = n + 1
                                local m = mats[i][j][k]
                                if m ~= air then solid = true end
                                mflat[n] = m.Value
                                oflat[n] = math.floor(occ[i][j][k] * 255 + 0.5)
                            end
                        end
                    end
                    if solid then
                        buf[#buf + 1] = {x = vx, y = vy, z = vz, sx = ax, sy = ay, sz = az,
                            M = rleEncode(mflat), O = rleEncode(oflat)}
                        saved = saved + 1
                        if #buf >= 6 then flush() end
                    end
                end

                done = done + 1
                if done % 2 == 0 then
                    setStatus(string.format("Copiando terreno... %d/%d blocos", done, totalChunks))
                    task.wait()
                end
            end
        end
    end
    flush()
    return files, saved
end

local function streamingSweep(recList, setStatus)
    if not Workspace.StreamingEnabled then return end

    local step = 256
    pcall(function() step = math.clamp(Workspace.StreamingTargetRadius * 0.8, 64, 512) end)

    local lastCount = -1
    for round = 1, 3 do
        if cancelRequested then return end
        if #recList == lastCount then break end
        lastCount = #recList

        local minX, minY, minZ, maxX, maxY, maxZ
        for _, rec in ipairs(recList) do
            local inst = rec.inst
            if inst:IsA("BasePart") then
                local p = inst.Position
                minX = minX and math.min(minX, p.X) or p.X
                minY = minY and math.min(minY, p.Y) or p.Y
                minZ = minZ and math.min(minZ, p.Z) or p.Z
                maxX = maxX and math.max(maxX, p.X) or p.X
                maxY = maxY and math.max(maxY, p.Y) or p.Y
                maxZ = maxZ and math.max(maxZ, p.Z) or p.Z
            end
        end
        if not minX then return end

        local s = step
        local function gridCount(sz)
            return (math.floor((maxX - minX) / sz) + 2) * (math.floor((maxY - minY) / sz) + 2)
                * (math.floor((maxZ - minZ) / sz) + 2)
        end
        while gridCount(s) > 3000 do s = s * 1.25 end

        local points = {}
        for x = minX, maxX + s, s do
            for y = minY, maxY + s, s do
                for z = minZ, maxZ + s, s do
                    points[#points + 1] = Vector3.new(x, y, z)
                end
            end
        end

        for i, pos in ipairs(points) do
            if cancelRequested then return end
            setStatus(string.format("Carregando o mapa (rodada %d/3): %d/%d", round, i, #points))
            pcall(function() player:RequestStreamAroundAsync(pos, 2) end)
            task.wait(0.1)
        end
        task.wait(1)
    end
end

