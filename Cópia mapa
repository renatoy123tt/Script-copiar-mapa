local function sanitizeName(text)
    text = tostring(text or "")
    text = (text:gsub('[\\/:*?"<>|%c]', ""))
    text = (text:gsub("^%s+", ""))
    text = (text:gsub("%s+$", ""))
    local cut = utf8.offset(text, 31)
    if cut then text = text:sub(1, cut - 1) end
    return text
end

local function isPlayerCharacter(inst)
    local ok, res = pcall(function()
        return inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) ~= nil
    end)
    return ok and res
end

-- Função que ancora tudo no Workspace do Studio Lite
local function anchorAllWorkspace()
    local count = 0
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") and not isPlayerCharacter(desc.Parent) then
            pcall(function()
                desc.Anchored = true
                count = count + 1
            end)
        end
    end
    StatusImport.Text = string.format("Sucesso! %d peças ancoradas no Workspace.", count)
end

