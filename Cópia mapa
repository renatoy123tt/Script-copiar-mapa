            if okR and #back == #content then return true end
        end
        task.wait(0.2)
    end
    return false
end

local function sn(x)
    if x ~= x then return 0 end
    return math.clamp(x, -3.4e38, 3.4e38)
end

local function encodeValue(v, records)
    local t = typeof(v)
    if t == "boolean" or t == "string" then
        return v
    elseif t == "number" then
        return sn(v)
    elseif t == "EnumItem" then
        return {_t = "Enum", e = tostring(v.EnumType), n = v.Name}
    elseif t == "Vector3" then
        return {_t = "V3", x = sn(v.X), y = sn(v.Y), z = sn(v.Z)}
    elseif t == "Vector2" then
        return {_t = "V2", x = sn(v.X), y = sn(v.Y)}
    elseif t == "Color3" then
        return {_t = "C3", r = v.R, g = v.G, b = v.B}
    elseif t == "CFrame" then
        local c = {v:GetComponents()}
        for i = 1, #c do c[i] = sn(c[i]) end
        return {_t = "CF", c = c}
    elseif t == "UDim" then
        return {_t = "UD", s = sn(v.Scale), o = v.Offset}
    elseif t == "UDim2" then
        return {_t = "UD2", xs = sn(v.X.Scale), xo = v.X.Offset, ys = sn(v.Y.Scale), yo = v.Y.Offset}
    elseif t == "NumberRange" then
        return {_t = "NR", min = sn(v.Min), max = sn(v.Max)}
    elseif t == "NumberSequence" then
        local k = {}
        for _, kp in ipairs(v.Keypoints) do k[#k + 1] = {kp.Time, sn(kp.Value), sn(kp.Envelope)} end
        return {_t = "NS", k = k}
    elseif t == "ColorSequence" then
        local k = {}
        for _, kp in ipairs(v.Keypoints) do k[#k + 1] = {kp.Time, kp.Value.R, kp.Value.G, kp.Value.B} end
        return {_t = "CS", k = k}
    elseif t == "BrickColor" then
        return {_t = "BC", n = v.Name}
    elseif t == "Rect" then
        return {_t = "Rect", x0 = sn(v.Min.X), y0 = sn(v.Min.Y), x1 = sn(v.Max.X), y1 = sn(v.Max.Y)}
    elseif t == "Font" then
        return {_t = "Font", f = v.Family, w = v.Weight.Name, s = v.Style.Name}
    elseif t == "PhysicalProperties" then
        return {_t = "PP", d = v.Density, f = v.Friction, e = v.Elasticity, fw = v.FrictionWeight, ew = v.ElasticityWeight}
    elseif t == "Instance" then
        local r = records and records[v]
        if r and r.oid then return {_t = "Ref", id = r.oid} end
        return nil
    end
    return nil
end

local function decodeValue(v)
    if type(v) ~= "table" then return v end
    local t = v._t
    if t == "Enum" then
        return Enum[(v.e:gsub("^Enum%.", ""))][v.n]
    elseif t == "V3" then return Vector3.new(v.x, v.y, v.z)
    elseif t == "V2" then return Vector2.new(v.x, v.y)
    elseif t == "C3" then return Color3.new(v.r, v.g, v.b)
    elseif t == "CF" then return CFrame.new(unpack(v.c))
    elseif t == "UD" then return UDim.new(v.s, v.o)
    elseif t == "UD2" then return UDim2.new(v.xs, v.xo, v.ys, v.yo)
    elseif t == "NR" then return NumberRange.new(v.min, v.max)
    elseif t == "NS" then
        local kp = {}
        for _, k in ipairs(v.k) do kp[#kp + 1] = NumberSequenceKeypoint.new(k[1], k[2], k[3]) end
        return NumberSequence.new(kp)
    elseif t == "CS" then
        local kp = {}
        for _, k in ipairs(v.k) do kp[#kp + 1] = ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4])) end
        return ColorSequence.new(kp)
    elseif t == "BC" then return BrickColor.new(v.n)
    elseif t == "Rect" then return Rect.new(v.x0, v.y0, v.x1, v.y1)
    elseif t == "Font" then return Font.new(v.f, Enum.FontWeight[v.w], Enum.FontStyle[v.s])
    elseif t == "PP" then return PhysicalProperties.new(v.d, v.f, v.e, v.fw, v.ew)
    end
    return nil
end

