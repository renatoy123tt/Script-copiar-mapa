local function finishCopy()
    isRunning = false
    CopyActionBtn.Visible = true
    CancelCopyBtn.Visible = false
end

local function runCopy()
    local function setStatus(text) StatusCopy.Text = text end

    local records, recList = {}, {}

    local function register(inst, root)
        if records[inst] then return end
        if inst == ScreenGui then return end
        if excludedClasses[inst.ClassName] then return end
        if isPlayerCharacter(inst) then return end
        local rec = {inst = inst, parent = inst.Parent, root = root}
        records[inst] = rec
        recList[#recList + 1] = rec
    end

    setStatus("Escaneando o mapa...")
    activeConn = Workspace.DescendantAdded:Connect(function(d) register(d, "Workspace") end)

    local n = 0
    for _, svc in ipairs({{Workspace, "Workspace"}, {Lighting, "Lighting"}}) do
        for _, d in ipairs(svc[1]:GetDescendants()) do
            register(d, svc[2])
            n = n + 1
            if n % 500 == 0 then task.wait() end
        end
    end

    streamingSweep(recList, setStatus)
    if cancelRequested then
        setStatus("Cópia cancelada.")
        return
    end
    if activeConn then activeConn:Disconnect(); activeConn = nil end

    local children = {}
    for _, rec in ipairs(recList) do
        local key
        if rec.parent == Workspace then key = "Workspace"
        elseif rec.parent == Lighting then key = "Lighting"
        else key = rec.parent end
        if key then
            children[key] = children[key] or {}
            table.insert(children[key], rec)
        end
    end

    local ordered, stack = {}, {}
    local function pushChildren(key)
        local list = children[key]
        if list then
            for i = #list, 1, -1 do stack[#stack + 1] = list[i] end
        end
    end
    pushChildren("Workspace")
    pushChildren("Lighting")
    while #stack > 0 do
        local rec = table.remove(stack)
        if not isPlayerCharacter(rec.inst) then
            ordered[#ordered + 1] = rec
            rec.oid = #ordered
            pushChildren(rec.inst)
        end
        if #ordered % 2000 == 0 then task.wait() end
    end

    local total = #ordered
    local hasTerrain = Workspace:FindFirstChildOfClass("Terrain") ~= nil
    if total == 0 and not hasTerrain then
        setStatus("Nenhum objeto compatível encontrado.")
        return
    end

    local userRootFolder = "MapBackups/User_" .. tostring(userId)
    local backupName = sanitizeName(NameBox.Text)
    if backupName == "" then backupName = "Mapa_" .. os.date("%Y%m%d_%H%M%S") end
    local mapFolder = userRootFolder .. "/" .. backupName
    local suffix = 2
    while isfolder(mapFolder) do
        mapFolder = userRootFolder .. "/" .. backupName .. "_" .. suffix
        suffix = suffix + 1
    end
    pcall(function()
        if not isfolder("MapBackups") then makefolder("MapBackups") end
        if not isfolder(userRootFolder) then makefolder(userRootFolder) end
        makefolder(mapFolder)
    end)

    local totalParts = math.ceil(total / CHUNK_SIZE)
    local processed, failedObjects, failedFiles = 0, 0, 0

    for partIndex = 1, totalParts do
        if cancelRequested then
            deleteBackupFolder(mapFolder)
            setProgress(0)
            setStatus("Cópia cancelada.")
            return
        end

        local entries = {}
        local first = (partIndex - 1) * CHUNK_SIZE + 1
        local last = math.min(partIndex * CHUNK_SIZE, total)
        for i = first, last do
            local okS, entry = pcall(serializeRecord, ordered[i], records)
            if okS then entries[#entries + 1] = entry else failedObjects = failedObjects + 1 end
            processed = processed + 1
            if processed % YIELD_EVERY == 0 then task.wait() end
        end

        local okEnc, encoded = pcall(HttpService.JSONEncode, HttpService, {Objects = entries})
        if not okEnc then
            local good = {}
            for _, e in ipairs(entries) do
                if pcall(HttpService.JSONEncode, HttpService, e) then
                    good[#good + 1] = e
                else
                    failedObjects = failedObjects + 1
                end
            end
            okEnc, encoded = pcall(HttpService.JSONEncode, HttpService, {Objects = good})
        end

        if not (okEnc and writeVerified(string.format("%s/Parte_%03d.json", mapFolder, partIndex), encoded)) then
            failedFiles = failedFiles + 1
        end

        local pct = processed / total
        setProgress(pct * 0.9)
        setStatus(string.format("Salvando parte %d/%d (%.0f%%)", partIndex, totalParts, pct * 100))
        task.wait(0.05)
    end

    local terrainFiles, terrainChunks = 0, 0
    if hasTerrain then
        local tf, tc = copyTerrain(mapFolder, setStatus)
        if tf == nil then
            deleteBackupFolder(mapFolder)
            setProgress(0)
            setStatus("Cópia cancelada.")
            return
        end
        terrainFiles, terrainChunks = tf, tc
    end

    local services = {
        Lighting = serializeProps(Lighting, lightingProps),
        Workspace = serializeProps(Workspace, workspaceProps),
        TerrainProps = {},
        TerrainColors = {},
    }
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        services.TerrainProps = serializeProps(terrain, terrainProps)
        for _, m in ipairs(Enum.Material:GetEnumItems()) do
            local okC, col = pcall(terrain.GetMaterialColor, terrain, m)
            if okC and col then services.TerrainColors[m.Name] = encodeValue(col, nil) end
        end
    end
    local okSv, svEnc = pcall(HttpService.JSONEncode, HttpService, services)
    if okSv then writeVerified(mapFolder .. "/Servicos.json", svEnc) end

    writeVerified(mapFolder .. "/Informacoes.json", HttpService:JSONEncode({
        Version = BACKUP_VERSION,
        OwnerUserId = userId,
        BackupName = backupName,
        Timestamp = os.time(),
        TotalObjects = total,
        TotalParts = totalParts,
        TerrainParts = terrainFiles,
        TerrainChunks = terrainChunks,
    }))

    setProgress(1)
    local msg = string.format("Sucesso! %d objetos, %d blocos de terreno.", total - failedObjects, terrainChunks)
    if failedObjects > 0 or failedFiles > 0 then
        msg = msg .. string.format(" Falhas: %d objetos, %d arquivos.", failedObjects, failedFiles)
    end
    setStatus(msg)
end

local function startCopyProcess()
    if isRunning then return end
    if not hasFileAPI then
        StatusCopy.Text = "Erro: seu executor não suporta escrita de arquivos."
        return
    end

    isRunning = true
    cancelRequested = false
    CopyActionBtn.Visible = false
    CancelCopyBtn.Visible = true
    setProgress(0)

    task.spawn(function()
        local ok, err = pcall(runCopy)
        if not ok then StatusCopy.Text = "Erro durante a cópia: " .. tostring(err) end
        if activeConn then activeConn:Disconnect(); activeConn = nil end
        finishCopy()
    end)
end

