local function loadBackupList()
    for _, child in ipairs(BackupScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    if not hasFileAPI then
        StatusImport.Text = "Erro: Sem acesso a arquivos do executor."
        return
    end
    
    pcall(function()
        if not isfolder("MapBackups") then makefolder("MapBackups") end
        local folders = listfiles("MapBackups")
        local yPos = 0
        
        for _, folderPath in ipairs(folders) do
            local folderName = folderPath:match("([^/]+)$") or folderPath
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 35)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            btn.Font = Enum.Font.Gotham
            btn.Text = "📁 " .. folderName
            btn.TextColor3 = Color3.fromRGB(240, 240, 245)
            btn.TextSize = 12
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = BackupScroll
            
            local UICornerB = Instance.new("UICorner")
            UICornerB.CornerRadius = UDim.new(0, 6)
            UICornerB.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                selectedBackupPath = folderPath
                StatusImport.Text = "Selecionado: " .. folderName
                for _, b in ipairs(BackupScroll:GetChildren()) do
                    if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(30, 30, 38) end
                end
                btn.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
            end)
            
            yPos = yPos + 40
        end
        BackupScroll.CanvasSize = UDim2.new(0, 0, 0, yPos)
    end)
end

local function startImportProcess()
    if isRunning then return end
    if not selectedBackupPath then
        StatusImport.Text = "Erro: Selecione um backup na lista acima!"
        return
    end
    
    isRunning = true
    StatusImport.Text = "Lendo partes do backup..."
    
    task.spawn(function()
        local successInfo, infoRaw = pcall(function()
            return readfile(selectedBackupPath .. "/Informacoes.json")
        end)
        
        if not successInfo then
            StatusImport.Text = "Erro ao ler Informacoes.json"
            isRunning = false
            return
        end
        
        local successDecInfo, infoData = pcall(function()
            return HttpService:JSONDecode(infoRaw)
        end)
        
        if not successDecInfo then
            StatusImport.Text = "Erro ao decodificar Informacoes.json"
            isRunning = false
            return
        end
        
        local totalParts = infoData.TotalParts or 1
        local importedFolder = Instance.new("Folder")
        importedFolder.Name = "MapaImportado_" .. os.date("%H%M%S")
        importedFolder.Parent = Workspace
        
        local totalImported = 0
        
        for partIdx = 1, totalParts do
            local partFileName = string.format("%s/Parte_%03d.json", selectedBackupPath, partIdx)
            local successPart, partRaw = pcall(function()
                return readfile(partFileName)
            end)
            
            if successPart then
                local successDecPart, partData = pcall(function()
                    return HttpService:JSONDecode(partRaw)
                end)
                
                if successDecPart and partData.Objects then
                    for _, itemData in ipairs(partData.Objects) do
                        pcall(function()
                            local newObj = Instance.new(itemData.ClassName)
                            newObj.Name = itemData.Name
                            
                            local props = itemData.Properties
                            if props then
                                if newObj:IsA("BasePart") then
                                    if props.Size then newObj.Size = Vector3.new(unpack(props.Size)) end
                                    if props.CFrame then newObj.CFrame = deserializeCFrame(props.CFrame) end
                                    if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                                    if props.Material and Enum.Material[props.Material] then 
                                        newObj.Material = Enum.Material[props.Material] 
                                    end
                                    if props.Transparency then newObj.Transparency = props.Transparency end
                                    if props.Reflectance then newObj.Reflectance = props.Reflectance end
                                    if props.Anchored ~= nil then newObj.Anchored = props.Anchored end
                                    if props.CanCollide ~= nil then newObj.CanCollide = props.CanCollide end
                                    if props.CastShadow ~= nil then newObj.CastShadow = props.CastShadow end
                                elseif newObj:IsA("MeshPart") then
                                    if props.MeshId then newObj.MeshId = props.MeshId end
                                    if props.TextureID then newObj.TextureID = props.TextureID end
                                elseif newObj:IsA("Decal") or newObj:IsA("Texture") then
                                    if props.Texture then newObj.Texture = props.Texture end
                                    if props.Transparency then newObj.Transparency = props.Transparency end
                                elseif newObj:IsA("Light") then
                                    if props.Brightness then newObj.Brightness = props.Brightness end
                                    if props.Range then newObj.Range = props.Range end
                                    if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                                    if props.Enabled ~= nil then newObj.Enabled = props.Enabled end
                                end
                            end
                            
                            newObj.Parent = importedFolder
                            totalImported = totalImported + 1
                        end)
                    end
                end
            end
            
            StatusImport.Text = string.format("Importando Parte %d / %d", partIdx, totalParts)
            task.wait(0.02)
        end
        
        StatusImport.Text = string.format("Sucesso! %d objetos importados.", totalImported)
        isRunning = false
    end)
end

