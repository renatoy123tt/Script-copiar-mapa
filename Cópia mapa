local function loadBackupList()
    for _, child in ipairs(BackupScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if not hasFileAPI then
        StatusGen.Text = "Erro: sem acesso a arquivos do executor."
        return
    end

    pcall(function()
        local userRootFolder = "MapBackups/User_" .. tostring(userId)
        if not isfolder("MapBackups") or not isfolder(userRootFolder) then return end

        local folders = listfiles(userRootFolder)
        for index, folderPath in ipairs(folders) do
            local folderName = folderPath:match("([^/\\]+)$") or folderPath

            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, 0, 0, 30)
            itemFrame.BackgroundTransparency = 1
            itemFrame.LayoutOrder = index
            itemFrame.Parent = BackupScroll

            local selectBtn = Instance.new("TextButton")
            selectBtn.Size = UDim2.new(1, -34, 1, 0)
            selectBtn.BackgroundColor3 = Theme.Surface2
            selectBtn.BorderSizePixel = 0
            selectBtn.Font = Enum.Font.Gotham
            selectBtn.Text = "  📦 " .. folderName
            selectBtn.TextColor3 = Theme.Text
            selectBtn.TextSize = 11
            selectBtn.TextXAlignment = Enum.TextXAlignment.Left
            selectBtn.TextTruncate = Enum.TextTruncate.AtEnd
            selectBtn.Parent = itemFrame
            corner(selectBtn, 7)

            local deleteBtn = Instance.new("TextButton")
            deleteBtn.Size = Instance.new("Frame") and UDim2.new(0, 30, 1, 0)
            deleteBtn.Position = UDim2.new(1, -30, 0, 0)
            deleteBtn.BackgroundColor3 = Theme.Danger
            deleteBtn.BorderSizePixel = 0
            deleteBtn.Font = Enum.Font.GothamBold
            deleteBtn.Text = "🗑️"
            deleteBtn.TextColor3 = Theme.Text
            deleteBtn.TextSize = 12
            deleteBtn.Parent = itemFrame
            corner(deleteBtn, 7)

            if folderPath == selectedBackupPath then
                selectBtn.BackgroundColor3 = Theme.Accent
            end

            local confirmDelete = false
            deleteBtn.MouseButton1Click:Connect(function()
                if not confirmDelete then
                    confirmDelete = true
                    deleteBtn.Text = "⚠️"
                    deleteBtn.BackgroundColor3 = Theme.Warn
                    task.delay(3, function()
                        if deleteBtn and deleteBtn.Parent then
                            confirmDelete = false
                            deleteBtn.Text = "🗑️"
                            deleteBtn.BackgroundColor3 = Theme.Danger
                        end
                    end)
                else
                    deleteBackupFolder(folderPath)
                    if folderPath == selectedBackupPath then selectedBackupPath = nil end
                    StatusGen.Text = "Backup excluído."
                    loadBackupList()
                end
            end)

            selectBtn.MouseButton1Click:Connect(function()
                selectedBackupPath = folderPath
                StatusGen.Text = "Selecionado: " .. folderName
                for _, child in ipairs(BackupScroll:GetChildren()) do
                    if child:IsA("Frame") then
                        local btn = child:FindFirstChildOfClass("TextButton")
                        if btn then btn.BackgroundColor3 = Theme.Surface2 end
                    end
                end
                selectBtn.BackgroundColor3 = Theme.Accent
            end)
        end
    end)
end

local function generateMapScripts()
    if not selectedBackupPath then
        StatusGen.Text = "Selecione um backup na lista!"
        return
    end

    local okInfo, infoRaw = pcall(readfile, selectedBackupPath .. "/Informacoes.json")
    if not okInfo then
        StatusGen.Text = "Erro ao ler Informacoes.json"
        return
    end
    local info = HttpService:JSONDecode(infoRaw)

    StatusGen.Text = "Lendo dados e gerando código Lua..."
    task.spawn(function()
        local allObjectsCode = {}
        local currentCode = ""
        local fileCount = 1

        for partIdx = 1, (info.TotalParts or 0) do
            local okP, raw = pcall(readfile, string.format("%s/Parte_%03d.json", selectedBackupPath, partIdx))
            if okP then
                local data = HttpService:JSONDecode(raw)
                for _, obj in ipairs(data.Objects or {}) do
                    local line = string.format("tb[%d]={Id=%d,PId=%d,R='%s',N='%s',C='%s',Pr={", 
                        obj.Id, obj.Id, obj.ParentId, tostring(obj.Root), tostring(obj.Name), tostring(obj.ClassName))
                    
                    for _, p in ipairs(obj.P or {}) do
                        local name = p[1]
                        local val = p[2]
                        if type(val) == "table" then
                            if val._t == "CF" then
                                line = line .. string.format("%s=CFrame.new(%s),", name, table.concat(val.c, ","))
                            elseif val._t == "V3" then
                                line = line .. string.format("%s=Vector3.new(%f,%f,%f),", name, val.x, val.y, val.z)
                            elseif val._t == "C3" then
                                line = line .. string.format("%s=Color3.new(%f,%f,%f),", name, val.r, val.g, val.b)
                            elseif val._t == "Enum" then
                                line = line .. string.format("%s=Enum.%s.%s,", name, val.e:gsub("^Enum%.",""), val.n)
                            elseif val._t == "UD2" then
                                line = line .. string.format("%s=UDim2.new(%f,%d,%f,%d),", name, val.xs, val.xo, val.ys, val.yo)
                            elseif val._t == "Ref" then
                                line = line .. string.format("%s=%d,", name, val.id)
                            end
                        elseif type(val) == "boolean" or type(val) == "number" then
                            line = line .. string.format("%s=%s,", name, tostring(val))
                        elseif type(val) == "string" then
                            line = line .. string.format("%s=%q,", name, val)
                        end
                    end
                    line = line .. "}},\n"

                    if #currentCode + #line > 180000 then -- Limite seguro por script do Roblox
                        allObjectsCode[fileCount] = currentCode
                        fileCount = fileCount + 1
                        currentCode = ""
                    end
                    currentCode = currentCode .. line
                end
            end
        end
        if #currentCode > 0 then
            allObjectsCode[fileCount] = currentCode
        end

        -- Criar pasta para salvar os scripts gerados no executor
        local outFolder = selectedBackupPath .. "/ScriptsGerados"
        if isfolder(outFolder) then deleteBackupFolder(outFolder) end
        makefolder(outFolder)

        local templateMain = [[
-- MapLoader Script gerado automaticamente (Parte %d)
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local mapFolder = Workspace:FindFirstChild("MapaGerado") or Instance.new("Folder")
mapFolder.Name = "MapaGerado"
mapFolder.Parent = Workspace

local tb = {}
%s

local idMap = {}
for _, data in pairs(tb) do
    local parentObj = (data.PId == 0) and ((data.R == "Lighting") and Lighting or mapFolder) or idMap[data.PId]
    if parentObj then
        local ok, obj = pcall(Instance.new, data.C)
        if ok and obj then
            obj.Name = data.N
            for k, v in pairs(data.Pr) do
                if k ~= "Part0" and k ~= "Part1" then
                    pcall(function() obj[k] = v end)
                end
            end
            pcall(function() obj.Parent = parentObj end)
            idMap[data.Id] = obj
        end
    end
end

-- Ligar restrições (Welds, etc)
for _, data in pairs(tb) do
    local obj = idMap[data.Id]
    if obj then
        if data.Pr.Part0 and idMap[data.Pr.Part0] then pcall(function() obj.Part0 = idMap[data.Pr.Part0] end) end
        if data.Pr.Part1 and idMap[data.Pr.Part1] then pcall(function() obj.Part1 = idMap[data.Pr.Part1] end) end
    end
end
print("Mapa carregado com sucesso!")
]]

        for idx, codeChunk in ipairs(allObjectsCode) do
            local finalCode = string.format(templateMain, idx, codeChunk)
            writeVerified(string.format("%s/MapScript_Parte%d.lua", outFolder, idx), finalCode)
        end

        StatusGen.Text = string.format("Sucesso! %d script(s) gerados na pasta do backup.", #allObjectsCode)
    end)
end

