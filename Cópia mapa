    CopyContainer.Visible = copy
    ImportContainer.Visible = not copy
    TabCopyBtn.BackgroundColor3 = copy and Theme.Accent or Theme.Surface
    TabCopyBtn.TextColor3 = copy and Theme.Text or Theme.Muted
    TabImportBtn.BackgroundColor3 = copy and Theme.Surface or Theme.Accent
    TabImportBtn.TextColor3 = copy and Theme.Muted or Theme.Text
    if not copy then loadBackupList() end
end

TabCopyBtn.MouseButton1Click:Connect(function() setTab(true) end)
TabImportBtn.MouseButton1Click:Connect(function() setTab(false) end)

MinimizeBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    FloatBtn.Visible = true
end)

-- Ícone: arrasta livremente; toque simples reabre a janela
makeDraggable(FloatBtn, FloatBtn, function()
    MainFrame.Visible = true
    FloatBtn.Visible = false
end)

CopyActionBtn.MouseButton1Click:Connect(startCopyProcess)
CancelCopyBtn.MouseButton1Click:Connect(function() cancelRequested = true end)
RefreshBtn.MouseButton1Click:Connect(loadBackupList)
ImportActionBtn.MouseButton1Click:Connect(startImportProcess)

print("Sistema de Backup v3.2 carregado!")
