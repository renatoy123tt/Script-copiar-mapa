-- 2. SISTEMA DE SERIALIZAÇÃO & CÓPIA DE OBJETOS
--------------------------------------------------------------------------------

local supportedClasses = {
    ["Part"] = true,
    ["MeshPart"] = true,
    ["Model"] = true,
    ["Folder"] = true,
    ["UnionOperation"] = true,
    ["Decal"] = true,
    ["Texture"] = true,
    ["PointLight"] = true,
    ["SurfaceLight"] = true,
    ["SpotLight"] = true,
    ["SurfaceGui"] = true,
    ["BillboardGui"] = true
}

local function serializeCFrame(cf)
    local components = {cf:GetComponents()}
    return components
end

local function deserializeCFrame(components)
    return CFrame.new(unpack(components))
end

local function serializeObject(obj, parentPath)
    if not supportedClasses[obj.ClassName] then return nil end
    if obj == ScreenGui then return nil end
    
    local data = {
        Name = obj.Name,
        ClassName = obj.ClassName,
        Path = parentPath .. "/" .. obj.Name,
        Properties = {}
    }
    
    pcall(function()
        if obj:IsA("BasePart") then
            data.Properties.Size = {obj.Size.X, obj.Size.Y, obj.Size.Z}
            data.Properties.CFrame = serializeCFrame(obj.CFrame)
            data.Properties.Color = {obj.Color.R, obj.Color.G, obj.Color.B}
            data.Properties.Material = obj.Material.Name
            data.Properties.Transparency = obj.Transparency
            data.Properties.Reflectance = obj.Reflectance
            data.Properties.Anchored = obj.Anchored
            data.Properties.CanCollide = obj.CanCollide
            data.Properties.CastShadow = obj.CastShadow
        elseif obj:IsA("MeshPart") then
            data.Properties.MeshId = obj.MeshId
            data.Properties.TextureID = obj.TextureID
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            data.Properties.Texture = obj.Texture
            data.Properties.Transparency = obj.Transparency
            data.Properties.Face = obj.Face.Name
        elseif obj:IsA("Light") then
            data.Properties.Brightness = obj.Brightness
            data.Properties.Range = obj.Range
            data.Properties.Color = {obj.Color.R, obj.Color.G, obj.Color.B}
            data.Properties.Enabled = obj.Enabled
        end
    end)
    
    return data
end

local function startCopyProcess()
    if isRunning then return end
    isRunning = true
    cancelRequested = false
    
    CopyActionBtn.Visible = false
    CancelCopyBtn.Visible = true
    StatusCopy.Text = "Status: Escaneando objetos..."
    
    task.spawn(function()
        local objectsToProcess = {}
        
        local function scan(item, path)
            for _, child in ipairs(item:GetChildren()) do
                if child ~= ScreenGui and child.Name ~= "PlayerGui" then
                    if supportedClasses[child.ClassName] then
                        table.insert(objectsToProcess, {obj = child, path = path})
                        scan(child, path .. "/" .. child.Name)
                    end
                end
            end
        end
        
        pcall(function()
            scan(Workspace, "Workspace")
        end)
        
        local totalObjects = #objectsToProcess
        if totalObjects == 0 then
            StatusCopy.Text = "Status: Nenhum objeto compatível encontrado."
            isRunning = false
            CopyActionBtn.Visible = true
            CancelCopyBtn.Visible = false
            return
        end
        
        local serializedData = {
            Version = "1.0",
            Timestamp = os.time(),
            Total = totalObjects,
            Objects = {}
        }
        
        local batchSize = 50
        for i, itemData in ipairs(objectsToProcess) do
            if cancelRequested then
                StatusCopy.Text = "Status: Cópia cancelada pelo usuário."
                isRunning = false
                CopyActionBtn.Visible = true
                CancelCopyBtn.Visible = false
                ProgressBarC.Size = UDim2.new(0, 0, 1, 0)
                return
            end
            
            local serialized = serializeObject(itemData.obj, itemData.path)
            if serialized then
                table.insert(serializedData.Objects, serialized)
            end
            
            if i % batchSize == 0 or i == totalObjects then
                local pct = i / totalObjects
                ProgressBarC.Size = UDim2.new(pct, 0, 1, 0)
                StatusCopy.Text = string.format("Copiando: %d / %d (%.0f%%)", i, totalObjects, pct * 100)
                task.wait(0.01)
            end
        end
        
        local success, encoded = pcall(function()
            return HttpService:JSONEncode(serializedData)
        end)
        
        if success then
            ExportBox.Text = encoded
            StatusCopy.Text = string.format("Sucesso! %d objetos copiados.", totalObjects)
            
            if hasFileAPI then
                pcall(function()
                    if not isfolder("MapBackups") then
                        makefolder("MapBackups")
                    end
                    local fileName = "MapBackups/Mapa_" .. os.date("%Y%m%d_%H%M%S") .. ".json"
                    writefile(fileName, encoded)
                    StatusCopy.Text = StatusCopy.Text .. " (Salvo em /MapBackups)"
                end)
            end
        else
            StatusCopy.Text = "Erro ao serializar dados do mapa."
        end
        
        isRunning = false
        CopyActionBtn.Visible = true
        CancelCopyBtn.Visible = false
    end)
end

--------------------------------------------------------------------------------
-- 3. SISTEMA DE IMPORTAÇÃO E RECONSTRUÇÃO
--------------------------------------------------------------------------------

local function startImportProcess()
    if isRunning then return end
    
    local rawData = ImportBox.Text
    if rawData == "" then
        StatusImport.Text = "Erro: Caixa de dados vazia!"
        return
    end
    
    local successDecode, decodedData = pcall(function()
        return HttpService:JSONDecode(rawData)
    end)
    
    if not successDecode or not decodedData or not decodedData.Objects then
        StatusImport.Text = "Erro: Formato de JSON inválido!"
        return
    end
    
    isRunning = true
    StatusImport.Text = "Iniciando reconstrução..."
    
    task.spawn(function()
        local objectsList = decodedData.Objects
        local total = #objectsList
        local batchSize = 30
        
        local importedFolder = Instance.new("Folder")
        importedFolder.Name = "MapaImportado_" .. os.date("%H%M%S")
        importedFolder.Parent = Workspace
        
        for i, itemData in ipairs(objectsList) do
            pcall(function()
                local newObj = Instance.new(itemData.ClassName)
                newObj.Name = itemData.Name
                
                local props = itemData.Properties
                if props then
                    if newObj:IsA("BasePart") then
                        if props.Size then newObj.Size = Vector3.new(unpack(props.Size)) end
                        if props.CFrame then newObj.CFrame = deserializeCFrame(props.CFrame) end
                        if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                        if props.Material and Enum.Material[props.Material] then 
                            newObj.Material = Enum.Material[props.Material] 
                        end
                        if props.Transparency then newObj.Transparency = props.Transparency end
                        if props.Reflectance then newObj.Reflectance = props.Reflectance end
                        if props.Anchored ~= nil then newObj.Anchored = props.Anchored end
                        if props.CanCollide ~= nil then newObj.CanCollide = props.CanCollide end
                        if props.CastShadow ~= nil then newObj.CastShadow = props.CastShadow end
                    elseif newObj:IsA("MeshPart") then
                        if props.MeshId then newObj.MeshId = props.MeshId end
                        if props.TextureID then newObj.TextureID = props.TextureID end
                    elseif newObj:IsA("Decal") or newObj:IsA("Texture") then
                        if props.Texture then newObj.Texture = props.Texture end
                        if props.Transparency then newObj.Transparency = props.Transparency end
                    elseif newObj:IsA("Light") then
                        if props.Brightness then newObj.Brightness = props.Brightness end
                        if props.Range then newObj.Range = props.Range end
                        if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                        if props.Enabled ~= nil then newObj.Enabled = props.Enabled end
                    end
                end
                
                newObj.Parent = importedFolder
            end)
            
            if i % batchSize == 0 or i == total then
                StatusImport.Text = string.format("Importando: %d / %d (%.0f%%)", i, total, (i / total) * 100)
                task.wait(0.01)
            end
        end
        
        StatusImport.Text = string.format("Sucesso! %d objetos reconstruídos.", total)
        isRunning = false
    end)
end

