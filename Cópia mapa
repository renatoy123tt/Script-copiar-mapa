local function runImport()
    local okInfo, infoRaw = pcall(readfile, selectedBackupPath .. "/Informacoes.json")
    if not okInfo then
        StatusImport.Text = "Erro: arquivo de informações corrompido ou inexistente."
        return
    end

    local okDec, info = pcall(HttpService.JSONDecode, HttpService, infoRaw)
    if not okDec or info.OwnerUserId ~= userId then
        StatusImport.Text = "Acesso negado! Este backup pertence a outro jogador."
        return
    end
    if info.Version ~= BACKUP_VERSION then
        StatusImport.Text = "Este backup é de uma versão antiga e não é compatível. Faça o backup novamente."
        return
    end

    local importedFolder = Instance.new("Folder")
    importedFolder.Name = "MapaImportado_" .. os.date("%H%M%S")
    importedFolder.Parent = Workspace

    local idMap, pending, sizeFix = {}, {}, {}
    local imported, failed, n = 0, 0, 0
    local totalParts = info.TotalParts or 0

    for partIdx = 1, totalParts do
        local okPart, partRaw = pcall(readfile, string.format("%s/Parte_%03d.json", selectedBackupPath, partIdx))
        local okDecPart, partData
        if okPart then okDecPart, partData = pcall(HttpService.JSONDecode, HttpService, partRaw) end

        if okPart and okDecPart and partData.Objects then
            for _, entry in ipairs(partData.Objects) do
                local parentObj
                if entry.ParentId == 0 then
                    parentObj = (entry.Root == "Lighting") and Lighting or importedFolder
                else
                    parentObj = idMap[entry.ParentId]
                end

                local okC, obj = false, nil
                if parentObj then okC, obj = pcall(Instance.new, entry.ClassName) end

                if okC and obj then
                    pcall(function() obj.Name = entry.Name end)

                    for _, pair in ipairs(entry.P or {}) do
                        local name, enc = pair[1], pair[2]
                        if type(enc) == "table" and enc._t == "Ref" then
                            pending[#pending + 1] = {obj = obj, prop = name, id = enc.id}
                        elseif name == "WorldPivot" then
                            pending[#pending + 1] = {obj = obj, prop = name, enc = enc}
                        else
                            pcall(function() obj[name] = decodeValue(enc) end)
                        end
                    end

                    if entry.A then
                        for k, v in pairs(entry.A) do
                            pcall(obj.SetAttribute, obj, k, decodeValue(v))
                        end
                    end
                    if entry.T then
                        for _, tag in ipairs(entry.T) do
                            pcall(CollectionService.AddTag, CollectionService, obj, tag)
                        end
                    end

                    pcall(function()
                        if obj:IsA("BasePart") then obj.Anchored = true end
                    end)

                    pcall(function()
                        if obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                            local fix = {obj = obj}
                            for _, pair in ipairs(entry.P or {}) do
                                if pair[1] == "Size" then fix.size = decodeValue(pair[2]) end
                                if pair[1] == "CFrame" then fix.cf = decodeValue(pair[2]) end
                            end
                            if fix.size then sizeFix[#sizeFix + 1] = fix end
                        end
                    end)

                    if parentObj == Lighting then
                        for _, existing in ipairs(Lighting:GetChildren()) do
                            if existing.ClassName == obj.ClassName then existing:Destroy() end
                        end
                    end

                    local okP = pcall(function() obj.Parent = parentObj end)
                    if okP then
                        idMap[entry.Id] = obj
                        imported = imported + 1
                    else
                        failed = failed + 1
                    end
                else
                    failed = failed + 1
                end

                n = n + 1
                if n % YIELD_EVERY == 0 then task.wait() end
            end
        else
            failed = failed + 1
        end

        StatusImport.Text = string.format("Importando parte %d / %d", partIdx, totalParts)
        task.wait(0.02)
    end

    for _, p in ipairs(pending) do
        pcall(function()
            if p.id then
                local target = idMap[p.id]
                if target then p.obj[p.prop] = target end
            else
                p.obj[p.prop] = decodeValue(p.enc)
            end
        end)
    end

    if #sizeFix > 0 then
        pcall(function()
            local list = {}
            for _, f in ipairs(sizeFix) do list[#list + 1] = f.obj end
            StatusImport.Text = "Carregando malhas..."
            game:GetService("ContentProvider"):PreloadAsync(list)
        end)

        local TOL = 0.05
        local function isWrong(f)
            local ok, wrong = pcall(function() return (f.obj.Size - f.size).Magnitude > TOL end)
            return ok and wrong
        end
        local function fix(f)
            pcall(function()
                f.obj.Size = f.size
                if f.cf then f.obj.CFrame = f.cf end
            end)
        end

        local watchers = {}
        for _, f in ipairs(sizeFix) do
            local ok, conn = pcall(function()
                return f.obj:GetPropertyChangedSignal("Size"):Connect(function()
                    if isWrong(f) then fix(f) end
                end)
            end)
            if ok then watchers[#watchers + 1] = conn end
        end

        local stableRounds = 0
        for round = 1, 20 do
            task.wait(1)
            local wrongCount = 0
            for i, f in ipairs(sizeFix) do
                if isWrong(f) then
                    wrongCount = wrongCount + 1
                    fix(f)
                end
                if i % 200 == 0 then task.wait() end
            end
            StatusImport.Text = string.format("Conferindo tamanhos (rodada %d): %d corrigidas de %d",
                round, wrongCount, #sizeFix)
            if wrongCount == 0 then
                stableRounds = stableRounds + 1
                if stableRounds >= 3 then break end
            else
                stableRounds = 0
            end
        end

        task.delay(60, function()
            for _, conn in ipairs(watchers) do conn:Disconnect() end
        end)
    end

    local okSv, svRaw = pcall(readfile, selectedBackupPath .. "/Servicos.json")
    local services
    if okSv then
        local okD, sv = pcall(HttpService.JSONDecode, HttpService, svRaw)
        if okD then services = sv end
    end

    local function applyList(target, list)
        for _, pair in ipairs(list or {}) do
            pcall(function() target[pair[1]] = decodeValue(pair[2]) end)
        end
    end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if services then
        applyList(Lighting, services.Lighting)
        applyList(Workspace, services.Workspace)
        if terrain then
            applyList(terrain, services.TerrainProps)
            for name, enc in pairs(services.TerrainColors or {}) do
                pcall(function() terrain:SetMaterialColor(Enum.Material[name], decodeValue(enc)) end)
            end
        end
    end

    local terrainWritten = 0
    if terrain and (info.TerrainParts or 0) > 0 then
        local materialByValue = {}
        for _, m in ipairs(Enum.Material:GetEnumItems()) do materialByValue[m.Value] = m end

        for t = 1, info.TerrainParts do
            local okT, raw = pcall(readfile, string.format("%s/Terrain_%03d.json", selectedBackupPath, t))
            local okTD, data
            if okT then okTD, data = pcall(HttpService.JSONDecode, HttpService, raw) end
            if okT and okTD and data.Chunks then
                for _, c in ipairs(data.Chunks) do
                    local mflat, oflat = rleDecode(c.M), rleDecode(c.O)
                    local mats, occ, idx = {}, {}, 0
                    for i = 1, c.sx do
                        mats[i], occ[i] = {}, {}
                        for j = 1, c.sy do
                            mats[i][j], occ[i][j] = {}, {}
                            for k = 1, c.sz do
                                idx = idx + 1
                                mats[i][j][k] = materialByValue[mflat[idx]] or Enum.Material.Air
                                occ[i][j][k] = (oflat[idx] or 0) / 255
                            end
                        end
                    end
                    local region = Region3.new(
                        Vector3.new(c.x * 4, c.y * 4, c.z * 4),
                        Vector3.new((c.x + c.sx) * 4, (c.y + c.sy) * 4, (c.z + c.sz) * 4))
                    if pcall(terrain.WriteVoxels, terrain, region, 4, mats, occ) then
                        terrainWritten = terrainWritten + 1
                    end
                    task.wait()
                end
            end
            StatusImport.Text = string.format("Importando terreno %d / %d", t, info.TerrainParts)
        end
    end

    local msg = string.format("Sucesso! %d objetos (ancorados) e %d blocos de terreno importados.", imported, terrainWritten)
    if failed > 0 then msg = msg .. string.format(" %d itens não puderam ser criados.", failed) end
    StatusImport.Text = msg
end

local function startImportProcess()
    if isRunning then return end
    if not selectedBackupPath then
        StatusImport.Text = "Erro: selecione um backup na lista!"
        return
    end

    isRunning = true
    StatusImport.Text = "Verificando permissões e lendo partes..."

    task.spawn(function()
        local ok, err = pcall(runImport)
        if not ok then StatusImport.Text = "Erro na importação: " .. tostring(err) end
        isRunning = false
    end)
end

