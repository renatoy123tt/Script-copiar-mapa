-- Nome de arquivo seguro
local function sanitizeName(text)
    text = tostring(text or "")
    text = (text:gsub('[\\/:*?"<>|%c]', ""))
    text = (text:gsub("^%s+", ""))
    text = (text:gsub("%s+$", ""))
    local cut = utf8.offset(text, 31)
    if cut then text = text:sub(1, cut - 1) end
    return text
end

local supportedClasses = {
    ["Part"] = true, ["MeshPart"] = true, ["Model"] = true, ["Folder"] = true,
    ["UnionOperation"] = true, ["Decal"] = true, ["Texture"] = true,
    ["PointLight"] = true, ["SurfaceLight"] = true, ["SpotLight"] = true,
    ["SurfaceGui"] = true, ["BillboardGui"] = true
}

local function serializeCFrame(cf)
    return {cf:GetComponents()}
end

local function deserializeCFrame(components)
    return CFrame.new(unpack(components))
end

local function serializeObject(obj, parentPath)
    if not supportedClasses[obj.ClassName] then return nil end
    if obj == ScreenGui then return nil end

    local data = {
        Name = obj.Name,
        ClassName = obj.ClassName,
        Path = parentPath .. "/" .. obj.Name,
        Properties = {}
    }

    pcall(function()
        if obj:IsA("BasePart") then
            data.Properties.Size = {obj.Size.X, obj.Size.Y, obj.Size.Z}
            data.Properties.CFrame = serializeCFrame(obj.CFrame)
            data.Properties.Color = {obj.Color.R, obj.Color.G, obj.Color.B}
            data.Properties.Material = obj.Material.Name
            data.Properties.Transparency = obj.Transparency
            data.Properties.Reflectance = obj.Reflectance
            data.Properties.Anchored = true -- mapa sempre ancorado
            data.Properties.CanCollide = obj.CanCollide
            data.Properties.CastShadow = obj.CastShadow
            if obj:IsA("MeshPart") then
                data.Properties.MeshId = obj.MeshId
                data.Properties.TextureID = obj.TextureID
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            data.Properties.Texture = obj.Texture
            data.Properties.Transparency = obj.Transparency
        elseif obj:IsA("Light") then
            data.Properties.Brightness = obj.Brightness
            data.Properties.Range = obj.Range
            data.Properties.Color = {obj.Color.R, obj.Color.G, obj.Color.B}
            data.Properties.Enabled = obj.Enabled
        end
    end)

    return data
end

--------------------------------------------------------------------------------
-- 4. PROCESSO DE CÓPIA
--------------------------------------------------------------------------------

local function finishCopy()
    isRunning = false
    CopyActionBtn.Visible = true
    CancelCopyBtn.Visible = false
end

local function startCopyProcess()
    if isRunning then return end
    if not hasFileAPI then
        StatusCopy.Text = "Erro: seu executor não suporta escrita de arquivos."
        return
    end

    isRunning = true
    cancelRequested = false
    CopyActionBtn.Visible = false
    CancelCopyBtn.Visible = true
    StatusCopy.Text = "Escaneando Workspace..."
    setProgress(0)

    task.spawn(function()
        local objectsToProcess = {}

        local function scan(item, path)
            for _, child in ipairs(item:GetChildren()) do
                if supportedClasses[child.ClassName] then
                    table.insert(objectsToProcess, {obj = child, path = path})
                    scan(child, path .. "/" .. child.Name)
                end
            end
        end

        pcall(function() scan(Workspace, "Workspace") end)

        local totalObjects = #objectsToProcess
        if totalObjects == 0 then
            StatusCopy.Text = "Nenhum objeto compatível encontrado."
            finishCopy()
            return
        end

        local chunkSize = 150
        local totalParts = math.ceil(totalObjects / chunkSize)

        local userRootFolder = "MapBackups/User_" .. tostring(userId)
        local backupName = sanitizeName(NameBox.Text)
        if backupName == "" then
            backupName = "Mapa_" .. os.date("%Y%m%d_%H%M%S")
        end
        local mapFolderName = userRootFolder .. "/" .. backupName
        local suffix = 2
        while isfolder(mapFolderName) do
            mapFolderName = userRootFolder .. "/" .. backupName .. "_" .. suffix
            suffix = suffix + 1
        end

        pcall(function()
            if not isfolder("MapBackups") then makefolder("MapBackups") end
            if not isfolder(userRootFolder) then makefolder(userRootFolder) end
            makefolder(mapFolderName)
        end)

        pcall(function()
            writefile(mapFolderName .. "/Informacoes.json", HttpService:JSONEncode({
                OwnerUserId = userId,
                BackupName = backupName,
                Timestamp = os.time(),
                TotalObjects = totalObjects,
                TotalParts = totalParts
            }))
        end)

        local processed = 0
        for partIndex = 1, totalParts do
            if cancelRequested then
                StatusCopy.Text = "Cópia cancelada."
                setProgress(0)
                finishCopy()
                return
            end

            local partObjects = {}
            local startIndex = (partIndex - 1) * chunkSize + 1
            local endIndex = math.min(partIndex * chunkSize, totalObjects)

            for i = startIndex, endIndex do
                local item = objectsToProcess[i]
                local serialized = serializeObject(item.obj, item.path)
                if serialized then table.insert(partObjects, serialized) end
                processed = processed + 1
            end

            local ok, encoded = pcall(function()
                return HttpService:JSONEncode({Objects = partObjects})
            end)
            if ok then
                pcall(function()
                    writefile(string.format("%s/Parte_%03d.json", mapFolderName, partIndex), encoded)
                end)
            end

            local pct = processed / totalObjects
            setProgress(pct)
            StatusCopy.Text = string.format("Salvando parte %d/%d (%.0f%%)", partIndex, totalParts, pct * 100)
            task.wait(0.02)
        end

        StatusCopy.Text = string.format("Sucesso! %d objetos salvos no seu backup privado.", totalObjects)
        finishCopy()
    end)
end

