local function serializeProps(obj, list)
    local P = {}
    for _, name in ipairs(list) do
        local ok, v = pcall(function() return obj[name] end)
        if ok and v ~= nil then
            local enc = encodeValue(v, nil)
            if enc ~= nil then P[#P + 1] = {name, enc} end
        end
    end
    return P
end

local function serializeRecord(rec, records)
    local obj = rec.inst
    local parentRec = records[rec.parent]
    local entry = {
        Id = rec.oid,
        ParentId = parentRec and parentRec.oid or 0,
        Root = rec.root,
        Name = obj.Name,
        ClassName = obj.ClassName,
        P = {},
    }

    local seen = {}
    for _, group in ipairs(propertyGroups) do
        local okIs, isA = pcall(function() return obj:IsA(group[1]) end)
        if okIs and isA then
            for _, name in ipairs(group[2]) do
                if not seen[name] then
                    seen[name] = true
                    local ok, v = pcall(function() return obj[name] end)
                    if ok and v ~= nil then
                        local enc = encodeValue(v, records)
                        if enc ~= nil then entry.P[#entry.P + 1] = {name, enc} end
                    end
                end
            end
        end
    end

    local okA, isPart = pcall(function() return obj:IsA("BasePart") end)
    if okA and isPart then
        local found = false
        for _, pair in ipairs(entry.P) do
            if pair[1] == "Anchored" then
                pair[2] = true
                found = true
                break
            end
        end
        if not found then
            entry.P[#entry.P + 1] = {"Anchored", true}
        end
    end

    pcall(function()
        local attrs = {}
        local any = false
        for k, v in pairs(obj:GetAttributes()) do
            local enc = encodeValue(v, records)
            if enc ~= nil then attrs[k] = enc; any = true end
        end
        if any then entry.A = attrs end
    end)
    pcall(function()
        local tags = CollectionService:GetTags(obj)
        if #tags > 0 then entry.T = tags end
    end)

    return entry
end

