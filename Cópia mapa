-- 4. GERADOR DE SCRIPTS PARA O SERVERSCRIPTSERVICE (tudo Anchored = true)
--------------------------------------------------------------------------------

local function fmtNum(n)
    return string.format("%.9g", n)
end

-- converte um valor salvo em código Lua (ou nil se o tipo não for suportado)
local function luaValue(val)
    local t = type(val)
    if t == "boolean" then
        return tostring(val)
    elseif t == "number" then
        return fmtNum(val)
    elseif t == "string" then
        return string.format("%q", val)
    elseif t == "table" then
        local k = val._t
        if k == "CF" then
            local parts = {}
            for i, c in ipairs(val.c) do parts[i] = fmtNum(c) end
            return "CFrame.new(" .. table.concat(parts, ",") .. ")"
        elseif k == "V3" then
            return string.format("Vector3.new(%s,%s,%s)", fmtNum(val.x), fmtNum(val.y), fmtNum(val.z))
        elseif k == "V2" then
            return string.format("Vector2.new(%s,%s)", fmtNum(val.x), fmtNum(val.y))
        elseif k == "C3" then
            return string.format("Color3.new(%s,%s,%s)", fmtNum(val.r), fmtNum(val.g), fmtNum(val.b))
        elseif k == "UD" then
            return string.format("UDim.new(%s,%s)", fmtNum(val.s), fmtNum(val.o))
        elseif k == "UD2" then
            return string.format("UDim2.new(%s,%s,%s,%s)", fmtNum(val.xs), fmtNum(val.xo), fmtNum(val.ys), fmtNum(val.yo))
        elseif k == "NR" then
            return string.format("NumberRange.new(%s,%s)", fmtNum(val.min), fmtNum(val.max))
        elseif k == "BC" then
            return string.format("BrickColor.new(%q)", val.n)
        elseif k == "Enum" then
            local e = (val.e:gsub("^Enum%.", ""))
            return "Enum." .. e .. "." .. val.n
        end
    end
    return nil
end

-- Cabeçalho (igual em todas as partes). PART e TOTAL são definidos antes dele.
local SCRIPT_HEADER = [==[
-- Coloque TODAS as partes no ServerScriptService. Elas carregam em ordem sozinhas.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local AssetService = game:GetService("AssetService")

shared.MapLoaderState = shared.MapLoaderState or {done = 0, idMap = {}, pending = {}, seen = {}}
local state = shared.MapLoaderState
repeat task.wait() until state.done >= PART - 1 -- espera a parte anterior terminar

local mapFolder = Workspace:FindFirstChild("MapaGerado")
if not mapFolder then
    mapFolder = Instance.new("Folder")
    mapFolder.Name = "MapaGerado"
    mapFolder.Parent = Workspace
end

]==]

-- Rodapé (igual em todas as partes): cria os objetos, ancora tudo e liga as referências.
local SCRIPT_FOOTER = [==[

local idMap, pending = state.idMap, state.pending

for i, data in ipairs(tb) do
    local parentObj
    if data.PId == 0 then
        parentObj = (data.R == "Lighting") and Lighting or mapFolder
    else
        parentObj = idMap[data.PId]
    end

    if parentObj then
        local obj

        -- MeshId não pode ser definido depois da criação, então a MeshPart é criada já com a malha
        if data.C == "MeshPart" and data.Pr.MeshId then
            local okM, mesh = pcall(function()
                return AssetService:CreateMeshPartAsync(data.Pr.MeshId, {
                    CollisionFidelity = data.Pr.CollisionFidelity,
                    RenderFidelity = data.Pr.RenderFidelity,
                })
            end)
            if okM then obj = mesh end
        end
        if not obj then
            local okI, created = pcall(Instance.new, data.C)
            if okI then obj = created end
        end

        if obj then
            obj.Name = data.N
            for k, v in pairs(data.Pr) do
                if k ~= "MeshId" then
                    pcall(function() obj[k] = v end)
                end
            end

            -- tudo ancorado
            if obj:IsA("BasePart") then
                obj.Anchored = true
            end

            for k, id in pairs(data.Rf) do
                pending[#pending + 1] = {obj = obj, prop = k, id = id}
            end

            -- itens do Lighting (Sky, Atmosphere...) substituem os que já existem
            if parentObj == Lighting and not state.seen[obj.ClassName] then
                state.seen[obj.ClassName] = true
                for _, existing in ipairs(Lighting:GetChildren()) do
                    if existing.ClassName == obj.ClassName then existing:Destroy() end
                end
            end

            obj.Parent = parentObj
            idMap[data.Id] = obj
        end
    end

    if i % 200 == 0 then task.wait() end
end

-- liga referências (Part0, Part1, PrimaryPart...) cujo alvo já existe;
-- as que apontam para partes futuras ficam esperando a próxima parte
local still = {}
for _, p in ipairs(pending) do
    local target = idMap[p.id]
    if target then
        pcall(function() p.obj[p.prop] = target end)
    else
        still[#still + 1] = p
    end
end
table.clear(pending)
for _, p in ipairs(still) do
    pending[#pending + 1] = p
end

state.done = PART
if PART == TOTAL then
    print("Mapa carregado por completo! (" .. TOTAL .. " parte(s))")
else
    print("Mapa: parte " .. PART .. "/" .. TOTAL .. " carregada")
end
]==]

local function loadBackupList() end -- definida mais abaixo

local function generateMapScripts(backupPath)
    if isRunning then
        StatusGen.Text = "Aguarde o processo atual terminar."
        return
    end
    if not backupPath then
        StatusGen.Text = "Selecione um backup na lista!"
        return
    end

    isRunning = true
    StatusGen.Text = "Lendo dados e gerando código Lua..."

    task.spawn(function()
        local ok, err = pcall(function()
            local okInfo, infoRaw = pcall(readfile, backupPath .. "/Informacoes.json")
            if not okInfo then
                StatusGen.Text = "Erro ao ler Informacoes.json (refaça o backup)."
                return
            end
            local info = HttpService:JSONDecode(infoRaw)
            local totalParts = info.TotalParts or 0

            -- código das configurações de iluminação/gravidade (vai só na parte 1)
            local extra = {}
            local okSv, svRaw = pcall(readfile, backupPath .. "/Servicos.json")
            if okSv then
                local okD, services = pcall(HttpService.JSONDecode, HttpService, svRaw)
                if okD and services then
                    for _, p in ipairs(services.Lighting or {}) do
                        local code = luaValue(p[2])
                        if code then
                            extra[#extra + 1] = string.format("pcall(function() Lighting.%s = %s end)", p[1], code)
                        end
                    end
                    for _, p in ipairs(services.Workspace or {}) do
                        local code = luaValue(p[2])
                        if code then
                            extra[#extra + 1] = string.format("pcall(function() Workspace.%s = %s end)", p[1], code)
                        end
                    end
                end
            end

            -- monta as linhas de dados e divide em partes pelo tamanho
            local chunks = {}
            local lines, size = {}, 0

            local function closeChunk()
                if #lines > 0 then
                    chunks[#chunks + 1] = table.concat(lines)
                    lines, size = {}, 0
                end
            end

            local objectCount = 0
            for partIdx = 1, totalParts do
                local okP, raw = pcall(readfile, string.format("%s/Parte_%03d.json", backupPath, partIdx))
                if okP then
                    local okJ, data = pcall(HttpService.JSONDecode, HttpService, raw)
                    if okJ and data and data.Objects then
                        for _, obj in ipairs(data.Objects) do
                            local pr, rf = {}, {}
                            for _, p in ipairs(obj.P or {}) do
                                local name, val = p[1], p[2]
                                if type(val) == "table" and val._t == "Ref" then
                                    rf[#rf + 1] = string.format("%s=%d", name, val.id)
                                else
                                    local code = luaValue(val)
                                    if code then pr[#pr + 1] = name .. "=" .. code end
                                end
                            end

                            local line = string.format("tb[#tb+1]={Id=%d,PId=%d,R=%q,N=%q,C=%q,Pr={%s},Rf={%s}}\n",
                                obj.Id, obj.ParentId, tostring(obj.Root), tostring(obj.Name), tostring(obj.ClassName),
                                table.concat(pr, ","), table.concat(rf, ","))

                            if size + #line > MAX_SCRIPT_CHARS and #lines > 0 then
                                closeChunk()
                            end
                            lines[#lines + 1] = line
                            size = size + #line
                            objectCount = objectCount + 1
                        end
                    end
                end
                StatusGen.Text = string.format("Convertendo parte %d/%d do backup...", partIdx, totalParts)
                task.wait()
            end
            closeChunk()

            if #chunks == 0 then
                StatusGen.Text = "Nenhum objeto encontrado neste backup."
                return
            end

            -- grava os scripts
            local outFolder = backupPath .. "/ScriptsGerados"
            if isfolder(outFolder) then deleteBackupFolder(outFolder) end
            makefolder(outFolder)

            local failedWrites = 0
            for idx, dataCode in ipairs(chunks) do
                local source = table.concat({
                    "-- MapLoader gerado automaticamente (Parte ", idx, " de ", #chunks, ")\n",
                    "local PART, TOTAL = ", idx, ", ", #chunks, "\n",
                    SCRIPT_HEADER,
                    (idx == 1) and (table.concat(extra, "\n") .. "\n\n") or "",
                    "local tb = {}\n",
                    dataCode,
                    SCRIPT_FOOTER,
                })
                if not writeVerified(string.format("%s/MapScript_Parte%d.lua", outFolder, idx), source) then
                    failedWrites = failedWrites + 1
                end
                StatusGen.Text = string.format("Gravando script %d/%d...", idx, #chunks)
                task.wait()
            end

            local msg = string.format("Sucesso! %d objetos em %d script(s) (tudo Anchored). Pasta: %s",
                objectCount, #chunks, outFolder)
            if failedWrites > 0 then
                msg = msg .. string.format(" Falha ao gravar %d arquivo(s).", failedWrites)
            end
            StatusGen.Text = msg
        end)
        if not ok then StatusGen.Text = "Erro ao gerar scripts: " .. tostring(err) end
        isRunning = false
    end)
end

