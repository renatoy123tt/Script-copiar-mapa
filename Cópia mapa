-- 5. GERENCIADOR DE BACKUPS
--------------------------------------------------------------------------------

local function deleteBackupFolder(folderPath)
    pcall(function()
        for _, f in ipairs(listfiles(folderPath)) do
            pcall(delfile, f)
        end
        if type(delfolder) == "function" then
            pcall(delfolder, folderPath)
        end
    end)
end

local function loadBackupList()
    for _, child in ipairs(BackupScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if not hasFileAPI then
        StatusImport.Text = "Erro: sem acesso a arquivos do executor."
        return
    end

    pcall(function()
        local userRootFolder = "MapBackups/User_" .. tostring(userId)
        if not isfolder("MapBackups") then makefolder("MapBackups") end
        if not isfolder(userRootFolder) then makefolder(userRootFolder) end

        local folders = listfiles(userRootFolder)
        if #folders == 0 then
            StatusImport.Text = "Você ainda não tem backups."
            return
        end

        local rows = {}
        for index, folderPath in ipairs(folders) do
            local folderName = folderPath:match("([^/\\]+)$") or folderPath

            local itemFrame = Instance.new("Frame")
            itemFrame.Size = UDim2.new(1, 0, 0, 30)
            itemFrame.BackgroundTransparency = 1
            itemFrame.LayoutOrder = index
            itemFrame.Parent = BackupScroll

            local selectBtn = Instance.new("TextButton")
            selectBtn.Size = UDim2.new(1, -36, 1, 0)
            selectBtn.BackgroundColor3 = Theme.Surface2
            selectBtn.BorderSizePixel = 0
            selectBtn.Font = Enum.Font.Gotham
            selectBtn.Text = "  📁 " .. folderName
            selectBtn.TextColor3 = Theme.Text
            selectBtn.TextSize = 11
            selectBtn.TextXAlignment = Enum.TextXAlignment.Left
            selectBtn.TextTruncate = Enum.TextTruncate.AtEnd
            selectBtn.Parent = itemFrame
            corner(selectBtn, 7)

            local deleteBtn = Instance.new("TextButton")
            deleteBtn.Size = UDim2.new(0, 30, 1, 0)
            deleteBtn.Position = UDim2.new(1, -30, 0, 0)
            deleteBtn.BackgroundColor3 = Theme.Danger
            deleteBtn.BorderSizePixel = 0
            deleteBtn.Font = Enum.Font.GothamBold
            deleteBtn.Text = "🗑️"
            deleteBtn.TextColor3 = Theme.Text
            deleteBtn.TextSize = 12
            deleteBtn.Parent = itemFrame
            corner(deleteBtn, 7)

            rows[selectBtn] = true
            if folderPath == selectedBackupPath then
                selectBtn.BackgroundColor3 = Theme.Accent
            end

            local confirmDelete = false
            deleteBtn.MouseButton1Click:Connect(function()
                if not confirmDelete then
                    confirmDelete = true
                    deleteBtn.Text = "⚠️"
                    deleteBtn.BackgroundColor3 = Theme.Warn
                    task.delay(3, function()
                        if deleteBtn and deleteBtn.Parent then
                            confirmDelete = false
                            deleteBtn.Text = "🗑️"
                            deleteBtn.BackgroundColor3 = Theme.Danger
                        end
                    end)
                else
                    deleteBackupFolder(folderPath)
                    if folderPath == selectedBackupPath then selectedBackupPath = nil end
                    StatusImport.Text = "Backup excluído."
                    loadBackupList()
                end
            end)

            selectBtn.MouseButton1Click:Connect(function()
                selectedBackupPath = folderPath
                StatusImport.Text = "Selecionado: " .. folderName
                for btn in pairs(rows) do
                    btn.BackgroundColor3 = Theme.Surface2
                end
                selectBtn.BackgroundColor3 = Theme.Accent
            end)
        end
    end)
end

local function startImportProcess()
    if isRunning then return end
    if not selectedBackupPath then
        StatusImport.Text = "Erro: selecione um backup na lista!"
        return
    end

    isRunning = true
    StatusImport.Text = "Verificando permissões e lendo partes..."

    task.spawn(function()
        local okInfo, infoRaw = pcall(readfile, selectedBackupPath .. "/Informacoes.json")
        if not okInfo then
            StatusImport.Text = "Erro: arquivo de informações corrompido ou inexistente."
            isRunning = false
            return
        end

        local okDec, infoData = pcall(function() return HttpService:JSONDecode(infoRaw) end)
        if not okDec or infoData.OwnerUserId ~= userId then
            StatusImport.Text = "Acesso negado! Este backup pertence a outro jogador."
            isRunning = false
            return
        end

        local totalParts = infoData.TotalParts or 1
        local importedFolder = Instance.new("Folder")
        importedFolder.Name = "MapaImportado_" .. os.date("%H%M%S")
        importedFolder.Parent = Workspace

        local totalImported = 0

        for partIdx = 1, totalParts do
            local okPart, partRaw = pcall(readfile, string.format("%s/Parte_%03d.json", selectedBackupPath, partIdx))

            if okPart then
                local okDecPart, partData = pcall(function() return HttpService:JSONDecode(partRaw) end)

                if okDecPart and partData.Objects then
                    for _, itemData in ipairs(partData.Objects) do
                        pcall(function()
                            local newObj = Instance.new(itemData.ClassName)
                            newObj.Name = itemData.Name

                            local props = itemData.Properties
                            if props then
                                if newObj:IsA("BasePart") then
                                    if props.Size then newObj.Size = Vector3.new(unpack(props.Size)) end
                                    if props.CFrame then newObj.CFrame = deserializeCFrame(props.CFrame) end
                                    if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                                    if props.Material and Enum.Material[props.Material] then
                                        newObj.Material = Enum.Material[props.Material]
                                    end
                                    if props.Transparency then newObj.Transparency = props.Transparency end
                                    if props.Reflectance then newObj.Reflectance = props.Reflectance end
                                    newObj.Anchored = true -- todo o mapa importado fica ancorado
                                    if props.CanCollide ~= nil then newObj.CanCollide = props.CanCollide end
                                    if props.CastShadow ~= nil then newObj.CastShadow = props.CastShadow end
                                    if newObj:IsA("MeshPart") then
                                        pcall(function()
                                            if props.TextureID then newObj.TextureID = props.TextureID end
                                        end)
                                    end
                                elseif newObj:IsA("Decal") or newObj:IsA("Texture") then
                                    if props.Texture then newObj.Texture = props.Texture end
                                    if props.Transparency then newObj.Transparency = props.Transparency end
                                elseif newObj:IsA("Light") then
                                    if props.Brightness then newObj.Brightness = props.Brightness end
                                    if props.Range then newObj.Range = props.Range end
                                    if props.Color then newObj.Color = Color3.new(unpack(props.Color)) end
                                    if props.Enabled ~= nil then newObj.Enabled = props.Enabled end
                                end
                            end

                            newObj.Parent = importedFolder
                            totalImported = totalImported + 1
                        end)
                    end
                end
            end

            StatusImport.Text = string.format("Importando parte %d / %d", partIdx, totalParts)
            task.wait(0.02)
        end

        StatusImport.Text = string.format("Sucesso! %d objetos importados (ancorados).", totalImported)
        isRunning = false
    end)
end

