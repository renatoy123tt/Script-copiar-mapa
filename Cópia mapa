local function loadBackupList()
    for _, child in ipairs(BackupScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if not hasFileAPI then
        StatusImport.Text = "Erro: sem acesso a arquivos do executor."
        return
    end

    pcall(function()
        local userRootFolder = "MapBackups/User_" .. tostring(userId)
        if not isfolder("MapBackups") then makefolder("MapBackups") end
        if not isfolder(userRootFolder) then makefolder(userRootFolder) end

