local lightingProps = {"Ambient", "Brightness", "ColorShift_Bottom", "ColorShift_Top", "EnvironmentDiffuseScale",
    "EnvironmentSpecularScale", "GlobalShadows", "OutdoorAmbient", "ShadowSoftness", "ClockTime",
    "GeographicLatitude", "ExposureCompensation", "FogColor", "FogEnd", "FogStart"}
