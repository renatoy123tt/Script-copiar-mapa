local function serializeProps(obj, list)
    local P = {}
    for _, name in ipairs(list) do
        local ok, v = pcall(function() return obj[name] end)
        if ok and v ~= nil then
            local enc = encodeValue(v, nil)
            if enc ~= nil then P[#P + 1] = {name, enc} end
        end
    end
    return P
end

local function serializeRecord(rec, records)
    local obj = rec.inst
    local parentRec = records[rec.parent]
    local entry = {
        Id = rec.oid,
        ParentId = parentRec and parentRec.oid or 0,
        Root = rec.root,
        Name = obj.Name,
        ClassName = obj.ClassName,
        P = {},
    }

    local seen = {}
    for _, group in ipairs(propertyGroups) do
        local okIs, isA = pcall(function() return obj:IsA(group[1]) end)
        if okIs and isA then
            for _, name in ipairs(group[2]) do
                if not seen[name] then
                    seen[name] = true
                    local ok, v = pcall(function() return obj[name] end)
                    if ok and v ~= nil then
                        local enc = encodeValue(v, records)
                        if enc ~= nil then entry.P[#entry.P + 1] = {name, enc} end
                    end
                end
            end
        end
    end
    return entry
end

local function copyTerrain(mapFolder, setStatus)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if not terrain then return 0, 0 end

    local okE, ext = pcall(function() return terrain.MaxExtents end)
    if not okE or not ext then return 0, 0 end

    local mn, mx = ext.Min, ext.Max
    local C = TERRAIN_CHUNK
    local nx = math.ceil((mx.X - mn.X + 1) / C)
    local ny = math.ceil((mx.Y - mn.Y + 1) / C)
    local nz = math.ceil((mx.Z - mn.Z + 1) / C)
    local totalChunks = nx * ny * nz
    if totalChunks <= 0 or totalChunks > 15000 then return 0, 0 end

    local air = Enum.Material.Air
    local buf, files, saved, done = {}, 0, 0, 0

    local function flush()
        if #buf == 0 then return end
        files = files + 1
        local okJ, enc = pcall(HttpService.JSONEncode, HttpService, {Chunks = buf})
        if okJ then writeVerified(string.format("%s/Terrain_%03d.json", mapFolder, files), enc) end
        buf = {}
    end

    for ix = 0, nx - 1 do
        for iy = 0, ny - 1 do
            for iz = 0, nz - 1 do
                if cancelRequested then return nil end
                local vx, vy, vz = mn.X + ix * C, mn.Y + iy * C, mn.Z + iz * C
                local sx = math.min(C, mx.X - vx + 1)
                local sy = math.min(C, mx.Y - vy + 1)
                local sz = math.min(C, mx.Z - vz + 1)
                local region = Region3.new(Vector3.new(vx * 4, vy * 4, vz * 4), Vector3.new((vx + sx) * 4, (vy + sy) * 4, (vz + sz) * 4))

                local okR, mats, occ = pcall(terrain.ReadVoxels, terrain, region, 4)
                if okR and mats and occ then
                    local size = mats.Size
                    local ax, ay, az = size.X, size.Y, size.Z
                    local mflat, oflat, n, solid = {}, {}, 0, false
                    for i = 1, ax do
                        for j = 1, ay do
                            for k = 1, az do
                                n = n + 1
                                local m = mats[i][j][k]
                                if m ~= air then solid = true end
                                mflat[n] = m.Value
                                oflat[n] = math.floor(occ[i][j][k] * 255 + 0.5)
                            end
                        end
                    end
                    if solid then
                        buf[#buf + 1] = {x = vx, y = vy, z = vz, sx = ax, sy = ay, sz = az,
                            M = mflat, O = oflat}
                        saved = saved + 1
                        if #buf >= 4 then flush() end
                    end
                end
                done = done + 1
                if done % 5 == 0 then task.wait() end
            end
        end
    end
    flush()
    return files, saved
end

local function streamingSweep(recList, setStatus)
    if not Workspace.StreamingEnabled then return end
    local step = 256
    pcall(function() step = math.clamp(Workspace.StreamingTargetRadius * 0.8, 64, 512) end)

    local minX, minY, minZ, maxX, maxY, maxZ
    for _, rec in ipairs(recList) do
        local inst = rec.inst
        if inst:IsA("BasePart") then
            local p = inst.Position
            minX = minX and math.min(minX, p.X) or p.X
            minY = minY and math.min(minY, p.Y) or p.Y
            minZ = minZ and math.min(minZ, p.Z) or p.Z
            maxX = maxX and math.max(maxX, p.X) or p.X
            maxY = maxY and math.max(maxY, p.Y) or p.Y
            maxZ = maxZ and math.max(maxZ, p.Z) or p.Z
        end
    end
    if not minX then return end

    setStatus("Carregando o mapa (streaming)...")
    for x = minX, maxX + step, step do
        for z = minZ, maxZ + step, step do
            if cancelRequested then return end
            pcall(function() player:RequestStreamAroundAsync(Vector3.new(x, (minY + maxY) / 2, z), 2) end)
            task.wait(0.05)
        end
    end
end

local function isPlayerCharacter(inst)
    local ok, res = pcall(function()
        return inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) ~= nil
    end)
    return ok and res
end

local function runCopy()
    local function setStatus(text) StatusCopy.Text = text end
    local records, recList = {}, {}

    local function register(inst, root)
        if records[inst] then return end
        if inst == ScreenGui then return end
        if excludedClasses[inst.ClassName] then return end
        if isPlayerCharacter(inst) then return end
        local rec = {inst = inst, parent = inst.Parent, root = root}
        records[inst] = rec
        recList[#recList + 1] = rec
    end

    setStatus("Escaneando o mapa...")
    activeConn = Workspace.DescendantAdded:Connect(function(d) register(d, "Workspace") end)

    local n = 0
    for _, svc in ipairs({{Workspace, "Workspace"}, {Lighting, "Lighting"}}) do
        for _, d in ipairs(svc[1]:GetDescendants()) do
            register(d, svc[2])
            n = n + 1
            if n % 500 == 0 then task.wait() end
        end
    end

    streamingSweep(recList, setStatus)
    if activeConn then activeConn:Disconnect(); activeConn = nil end
    if cancelRequested then
        setStatus("Cópia cancelada.")
        return
    end

    local children = {}
    for _, rec in ipairs(recList) do
        local key = (rec.parent == Workspace) and "Workspace" or ((rec.parent == Lighting) and "Lighting" or rec.parent)
        if key then
            children[key] = children[key] or {}
            table.insert(children[key], rec)
        end
    end

    local ordered, stack = {}, {}
    local function pushChildren(key)
        local list = children[key]
        if list then
            for i = #list, 1, -1 do stack[#stack + 1] = list[i] end
        end
    end
    pushChildren("Workspace")
    pushChildren("Lighting")
    while #stack > 0 do
        local rec = table.remove(stack)
        if not isPlayerCharacter(rec.inst) then
            ordered[#ordered + 1] = rec
            rec.oid = #ordered
            pushChildren(rec.inst)
        end
        if #ordered % 2000 == 0 then task.wait() end
    end

    local total = #ordered
    local userRootFolder = "MapBackups/User_" .. tostring(userId)
    local backupName = sanitizeName(NameBox.Text)
    if backupName == "" then backupName = "Mapa_" .. os.date("%Y%m%d_%H%M%S") end
    local mapFolder = userRootFolder .. "/" .. backupName

    pcall(function()
        if not isfolder("MapBackups") then makefolder("MapBackups") end
        if not isfolder(userRootFolder) then makefolder(userRootFolder) end
        if isfolder(mapFolder) then deleteBackupFolder(mapFolder) end
        makefolder(mapFolder)
    end)

    local totalParts = math.ceil(total / CHUNK_SIZE)
    for partIndex = 1, totalParts do
        if cancelRequested then
            deleteBackupFolder(mapFolder)
            setProgress(0)
            setStatus("Cópia cancelada.")
            return
        end

        local entries = {}
        local first = (partIndex - 1) * CHUNK_SIZE + 1
        local last = math.min(partIndex * CHUNK_SIZE, total)
        for i = first, last do
            local okS, entry = pcall(serializeRecord, ordered[i], records)
            if okS then entries[#entries + 1] = entry end
        end
        local okEnc, encoded = pcall(HttpService.JSONEncode, HttpService, {Objects = entries})
        if okEnc then
            writeVerified(string.format("%s/Parte_%03d.json", mapFolder, partIndex), encoded)
        end
        setProgress(partIndex / totalParts * 0.9)
        setStatus(string.format("Salvando parte %d/%d", partIndex, totalParts))
        task.wait()
    end

    local terrainFiles, terrainChunks = copyTerrain(mapFolder, setStatus)
    if terrainFiles == nil then
        deleteBackupFolder(mapFolder)
        setProgress(0)
        setStatus("Cópia cancelada.")
        return
    end

    local services = {
        Lighting = serializeProps(Lighting, lightingProps),
        Workspace = serializeProps(Workspace, workspaceProps),
        TerrainProps = {},
    }
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        services.TerrainProps = serializeProps(terrain, terrainProps)
    end
    local okSv, svEnc = pcall(HttpService.JSONEncode, HttpService, services)
    if okSv then writeVerified(mapFolder .. "/Servicos.json", svEnc) end

    writeVerified(mapFolder .. "/Informacoes.json", HttpService:JSONEncode({
        Version = BACKUP_VERSION,
        TotalObjects = total,
        TotalParts = totalParts,
        TerrainParts = terrainFiles,
        TerrainChunks = terrainChunks,
        BackupName = backupName,
    }))

    setProgress(1)
    setStatus("Backup concluído com sucesso!")
end

local function finishCopy()
    isRunning = false
    CopyActionBtn.Visible = true
    CancelCopyBtn.Visible = false
end

